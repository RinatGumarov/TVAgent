{
  "manifest_version": 3,
  "name": "TVAgent — AI Agent for TradingView",
  "version": "0.1.0",
  "description": "Claude-powered agent that reads and drives TradingView through its native semantic API.",
  "homepage_url": "https://github.com/RinatGumarov/TVAgent",

  "permissions": ["storage"],

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "host_permissions": [
    "https://*.tradingview.com/*",
    "https://api.anthropic.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],

  "background": {
    "service_worker": "src/background/service-worker.js"
  },

  "content_scripts": [
    {
      "matches": ["https://*.tradingview.com/chart/*"],
      "js": ["src/injected/driver.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.tradingview.com/chart/*"],
      "js": [
        "src/content/bridge.js",
        "src/content/tools.js",
        "src/content/agent.js",
        "src/content/panel-mount.js",
        "src/content/panel-chat.js",
        "src/content/panel-settings.js",
        "src/content/panel.js"
      ],
      "css": ["src/content/panel.css"],
      "world": "ISOLATED",
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_title": "Toggle TVAgent panel",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
